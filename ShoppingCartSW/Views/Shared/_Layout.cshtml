<!DOCTYPE html>
<html lang="en">
@{
    //Check id the current user is logged in or not
    bool Authenticated = Context.User.Identity.IsAuthenticated;

}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShoppingCartSW</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" id="themeStyle" href="~/css/primary-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShoppingCartSW.styles.css" asp-append-version="true" />
    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
   
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow  bg-nav-colour">
            <div class="container-fluid">
                <img id="logo" src="~/images/Sams Warehouse Shopping Cart.svg" width="30px" height="30px" margin-right="10px"/>
                <a class="navbar-brand text-white" asp-area="" asp-controller="Home" asp-action="Index"><strong>Sam's Warehouse</strong></a>
                <button class="navbar-toggler bg-theme-text" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between bg-theme-text">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="AboutUs">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Product" asp-action="Index">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>


            <!--Buttons for the login, logoff and create user functionality-->
            <div class="col-3">
               

                @if (Authenticated)
                {
                    <a id="btnCartModal" class="btn btn-primary mx-1 float-end bg-nav-colour border-0"><i class="fas fa-shopping-cart"></i> Cart</a>
                    <a asp-action="Logoff" asp-controller="Authentication" class="btn btn-primary mx-1 float-end bg-nav-colour border-0" alt="Logout"><i class="fa-solid fa-right-from-bracket"></i></a>

                }
                else
                {
                    <a asp-action="Create" asp-controller="Authentication" class="btn btn-primary mx-1 float-end bg-nav-colour border-0" alt="Add User"><i class="fa-regular fa-user"></i></a>
                    <a asp-action="Login" asp-controller="Authentication" class="btn btn-primary mx-1 float-end bg-nav-colour border-0" alt="Login"><i class="fa-solid fa-right-to-bracket"></i></a>
                }
                <input id="btnTheme" type="button" class="btn btn-primary mx-1 float-end bg-nav-colour border-0" alt="theme">

            </div>

        </nav>
    </header>
    <div class="container" id="main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Modal -->
    <div class="modal right fade" id="cartModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div id="cartModalBody" class="modal-content">
            </div>
        </div>
    </div>

    <footer class="footer text-muted">
        <div class="container">
            &copy; 2024 - Sam' Warehouse' - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/shoppingcart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
