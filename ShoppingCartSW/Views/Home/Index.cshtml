@{
    ViewData["Title"] = "Home Page";
}

<div class="loading">
    <img class="loading__logo" src="./images/Sams Warehouse Shopping Cart.svg" alt="SW">
</div>
<div class="grid-container">
    <div class="text-content align-content-sm-start">
        <h1>We deliver healthy & delicious food to home</h1>
        <p>Your favorite products at the best prices!
            please see the awesome products.</p>
        <div id="home-button">
            <a class="btn btn-primary bg-button-colour" asp-area="" asp-controller="Product" asp-action="Index">See our product</a>
        </div>
    </div>
</div>
