@model ShoppingCartSW.Models.DTOs.CreateUserDTO

@{
    ViewData["Title"] = "Create";
    string errorMessage = ViewBag.CreateUserError ?? "";
    string confirmationMessage = ViewBag.CreateUserConfirmation ?? "";
}
<div class="grid-container">
    <div class="login-content mx-4">
<h1>Create</h1>



        <form asp-action="Create">
            @if (string.IsNullOrWhiteSpace(errorMessage) == false)
            {
                <label class="text-danger">@errorMessage</label>
            }
            @if (string.IsNullOrWhiteSpace(confirmationMessage) == false)
            {
                <label class="text-success">@confirmationMessage</label>
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <div class="input-container">
                <input asp-for="Password" class="form-control d-inline" type="password" />
                <i class="fa-regular fa-eye-slash " id="togglePasswordCreate"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PasswordConfirmation" class="control-label"></label>
                <div class="input-container">
                <input asp-for="PasswordConfirmation" class="form-control d-inline" type="password" />
                <i class="fa-regular fa-eye-slash " id="togglePasswordConfirm"></i>
                </div>
                <span asp-validation-for="PasswordConfirmation" class="text-danger"></span>
            </div>

            <div class="form-group mb-3 mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
        
   

<div>
    <a asp-area="" asp-controller="Product" asp-action="Index">Back to List</a>
</div>
    </div>

    </div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
